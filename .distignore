# Version control
.git/
.git
.gitignore
.gitattributes

# CI / automation config
.distignore
.github/
.wordpress-org/

# Dev tooling IDE folders (gitignored locally, excluded here for rsync safety)
.claude/
.codex/
.cursor/

# Key files (gitignored via .*key pattern; belt-and-braces)
.private_key/
.public_key/

# Cloudflare Worker source - not part of the WordPress plugin
cloudflare/

# Offline/proprietary modules - gitignored and never distributed
offline/

# GitHub-channel self-updater - release-package.yml already strips this from
# the WordPress.org-channel ZIP via an explicit rm, but the WordPress.org SVN
# deploy (wporg-deploy.yml, via 10up/action-wordpress-plugin-deploy) checks
# out the raw tagged tree and relies on .distignore alone, with no equivalent
# rm step -- so this repo-root file is the only thing standing between an
# SVN push and the exact "Plugin Updater detected" rejection this same file's
# other entries were already fixing. build-channel.php is generated only at
# release-package.yml build time and never exists in a raw checkout, so it
# needs no entry here.
includes/modules/class-github-update-checker.php

# Build artefacts and local tooling
build/
dist/
tools/
node_modules/
.phpunit.cache/
code-review-findings.json

# Composer deps not bundled in releases (no autoloader used at runtime)
vendor/
composer.json
composer.lock

# Node tooling
package.json
package-lock.json

# Test suite
test/
phpunit.xml
phpcs.xml.dist

# Developer documentation (not needed by end users)
docs/
requirements_spec.md
research.md
RESEARCH.md
SPECIFICATION.md
CHANGELOG.md
COMMERCIAL_TERMS.md
CONTRIBUTING.md
CONTRIBUTORS.md
